SPRING_PROFILES_ACTIVE=dev

DATABASE_URL=jdbc:postgresql://localhost:5432/hourslot
DATABASE_USER=hourslot
DATABASE_PASSWORD=change-me

# Base64-encoded secret, at least 64 bytes. Generate with: openssl rand -base64 64
JWT_SECRET=change-me
# Access token lifetime (default 15 min); the frontend refreshes automatically.
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Zone used to interpret booking wall-clock times.
APP_TIMEZONE=Asia/Karachi

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

FRONTEND_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
UPLOAD_DIR=uploads

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=you@example.com
MAIL_PASSWORD=change-me

# Cloudflare R2 (S3-compatible). Folders in bucket: verification/, profile/, categories/, request_media/
# Keep public access OFF for the verification/ prefix — documents are streamed through the API.
#
# Create credentials: Cloudflare Dashboard → R2 → Manage R2 API Tokens → Create API token
#   Permissions: Object Read & Write (or Admin Read & Write)
#   Specify bucket: hour-slot (or apply to all buckets)
#   Use the token's Access Key ID → R2_ACCESS_KEY and Secret Access Key → R2_SECRET_KEY
# A 403 Access Denied on upload almost always means the token was revoked or lacks write scope.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET_NAME=hour-slot
R2_PUBLIC_URL=https://pub-<id>.r2.dev
STORAGE_REGION=auto

# Online payments (Stripe Checkout). Leave empty to keep pay-at-venue only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# WhatsApp Cloud API webhook
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Web push. Generate a pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
